<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tela" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" android:text="@string/app_name" android:textColor="#131416"
            android:textSize="22sp" android:textStyle="bold" android:accessibilityHeading="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="vertical"
            android:padding="20dp" android:background="@drawable/folha">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/acesso" android:textColor="#131416" android:textSize="18sp"
                android:textStyle="bold" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/email" android:labelFor="@id/email" />
            <EditText android:id="@+id/email" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:autofillHints="emailAddress" android:inputType="textEmailAddress" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/senha" android:labelFor="@id/senha" />
            <EditText android:id="@+id/senha" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:autofillHints="password" android:inputType="textPassword" />
            <Button android:id="@+id/entrar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:backgroundTint="#131416" android:textColor="#FFFFFF"
                android:text="@string/entrar" android:textAllCaps="false" />
            <Button android:id="@+id/cadastrar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:backgroundTint="#F1F4F5"
                android:textColor="#131416" android:text="@string/criar_conta" android:textAllCaps="false" />
            <TextView android:id="@+id/mensagem_login" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textColor="#5D5F60" android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
