<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:orientation="horizontal"
    android:background="@drawable/folha" android:padding="16dp">
    <View android:id="@+id/marcador" android:layout_width="12dp" android:layout_height="12dp"
        android:layout_marginTop="5dp" android:layout_marginEnd="12dp"
        android:background="@drawable/marcador" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/titulo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/motivo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="#131416" android:visibility="gone" />
        <TextView android:id="@+id/autor" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="#5D5F60" />
        <TextView android:id="@+id/horario" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#5D5F60" />
    </LinearLayout>
</LinearLayout>
