<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tela" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" android:text="@string/historico" android:textColor="#131416"
            android:textSize="22sp" android:textStyle="bold" android:accessibilityHeading="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="vertical"
            android:background="@drawable/folha" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:labelFor="@id/codigo" android:text="@string/codigo_lote" />
            <EditText android:id="@+id/codigo" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:fontFamily="monospace"
                android:imeOptions="actionSearch" android:importantForAutofill="no"
                android:inputType="textNoSuggestions" android:maxLength="64"
                android:minHeight="48dp" />
            <Button android:id="@+id/consultar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:backgroundTint="#131416" android:textColor="#FFFFFF"
                android:text="@string/consultar" android:textAllCaps="false" />
        </LinearLayout>
        <TextView android:id="@+id/situacao" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:paddingHorizontal="8dp" android:textColor="#131416" android:textSize="16sp"
            android:textStyle="bold" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <Button android:id="@+id/reprovar" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:backgroundTint="#B3261E" android:textColor="#FFFFFF"
            android:text="@string/reprovar_lote" android:textAllCaps="false" android:visibility="gone" />
        <TextView android:id="@+id/vazio" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:paddingHorizontal="8dp" android:text="@string/historico_vazio"
            android:textColor="#5D5F60" android:visibility="gone" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/eventos"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingHorizontal="16dp" android:paddingBottom="16dp" />
</LinearLayout>
