<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tela" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" android:text="@string/app_name" android:textColor="#131416"
            android:textSize="22sp" android:textStyle="bold" android:accessibilityHeading="true" />
        <TextView android:id="@+id/perfil_atual" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" android:layout_marginTop="4dp"
            android:textColor="#5D5F60" android:textSize="14sp" />
        <Button android:id="@+id/sair" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/sair" android:textAllCaps="false" />
        <Button android:id="@+id/consultar_historico" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:backgroundTint="#FFFFFF" android:textColor="#131416"
            android:text="@string/consultar_historico" android:textAllCaps="false" />
        <LinearLayout android:id="@+id/form_etapas" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="vertical"
            android:background="@drawable/folha" android:padding="20dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/configurar_etapas" android:textSize="18sp" android:textStyle="bold"
                android:accessibilityHeading="true" />
            <TextView android:id="@+id/sequencia_atual" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/carregando_etapas" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:labelFor="@id/sequencia_etapas"
                android:text="@string/uma_etapa_por_linha" />
            <EditText android:id="@+id/sequencia_etapas" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine" android:minLines="4"
                android:maxLength="10099" android:hint="@string/exemplo_etapas" />
            <Button android:id="@+id/salvar_etapas" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:backgroundTint="#131416" android:textColor="#FFFFFF"
                android:text="@string/salvar_etapas" android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/form_lote" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="vertical"
            android:background="@drawable/folha" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/novo" android:textSize="18sp" android:textStyle="bold"
                android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:labelFor="@id/produto" android:text="@string/produto" />
            <EditText android:id="@+id/produto" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences" android:maxLength="100" android:minHeight="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:labelFor="@id/quantidade" android:text="@string/quantidade" />
            <EditText android:id="@+id/quantidade" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:maxLength="10" android:minHeight="48dp" />
            <Button android:id="@+id/criar" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:backgroundTint="#131416" android:textColor="#FFFFFF"
                android:text="@string/criar" android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/etiqueta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="vertical"
            android:background="@drawable/folha" android:padding="20dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/etiqueta" android:textSize="18sp" android:textStyle="bold"
                android:accessibilityHeading="true" />
            <TextView android:id="@+id/resumo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
            <ImageView android:id="@+id/qr" android:layout_width="176dp" android:layout_height="176dp"
                android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"
                android:contentDescription="@string/qr_descricao" />
            <TextView android:id="@+id/codigo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:gravity="center" android:textColor="#1B6C80"
                android:textIsSelectable="true" />
            <Button android:id="@+id/ver_historico" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:backgroundTint="#131416" android:textColor="#FFFFFF"
                android:text="@string/ver_historico" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
