rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function temPerfil() {
      return request.auth != null && perfil() in ['operador', 'qualidade'];
    }

    function nomeAutor() {
      let nome = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('nome', '');
      return nome is string && nome.trim().size() > 0 && nome.size() <= 100 ? nome : 'Qualidade';
    }

    match /usuarios/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    match /etapas/{etapaId} {
      allow read: if temPerfil();
    }

    match /configuracao/etapas {
      allow read: if temPerfil();
      allow create, update: if request.auth != null
        && perfil() == 'qualidade'
        && request.resource.data.keys().hasOnly(['etapas'])
        && request.resource.data.keys().hasAll(['etapas'])
        && request.resource.data.etapas is list
        && request.resource.data.etapas.size() > 0
        && request.resource.data.etapas.size() <= 100;
    }

    match /lotes/{loteId} {
      allow read: if temPerfil();
      allow create: if request.auth != null
        && perfil() == 'operador'
        && request.resource.data.keys().hasAll([
          'produto', 'quantidade', 'criadoEm', 'criadoPor', 'status', 'etapaAtual', 'etapas'
        ])
        && request.resource.data.keys().hasOnly([
          'produto', 'quantidade', 'criadoEm', 'criadoPor', 'status', 'etapaAtual', 'etapas'
        ])
        && request.resource.data.etapas is list
        && request.resource.data.etapas.size() > 0
        && request.resource.data.etapas == get(
          /databases/$(database)/documents/configuracao/etapas
        ).data.etapas
        && request.resource.data.produto is string
        && request.resource.data.produto.size() <= 100
        && request.resource.data.produto.matches('.*[^\\s].*')
        && request.resource.data.quantidade is int
        && request.resource.data.quantidade > 0
        && request.resource.data.quantidade <= 2147483647
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && request.resource.data.status == 'ativo'
        && request.resource.data.etapaAtual is int
        && request.resource.data.etapaAtual == 0;
      allow update: if request.auth != null
        && perfil() == 'qualidade'
        && resource.data.status == 'ativo'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'reprovado'
        && getAfter(/databases/$(database)/documents/lotes/$(loteId)/historico/reprovacao).data.tipo == 'reprovacao';

      match /historico/{eventoId} {
        allow read: if temPerfil();
        allow create: if request.auth != null
          && eventoId == 'reprovacao'
          && perfil() == 'qualidade'
          && get(/databases/$(database)/documents/lotes/$(loteId)).data.status == 'ativo'
          && getAfter(/databases/$(database)/documents/lotes/$(loteId)).data.status == 'reprovado'
          && request.resource.data.keys().hasAll([
            'tipo', 'motivo', 'autorUid', 'autorNome', 'registradoEm'
          ])
          && request.resource.data.keys().hasOnly([
            'tipo', 'motivo', 'autorUid', 'autorNome', 'registradoEm'
          ])
          && request.resource.data.tipo == 'reprovacao'
          && request.resource.data.motivo is string
          && request.resource.data.motivo.matches('(?s).*\\S.*')
          && request.resource.data.motivo.size() <= 300
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.autorNome == nomeAutor()
          && request.resource.data.registradoEm == request.time;
      }
    }
  }
}
